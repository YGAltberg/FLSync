"""FLSync: send the notes in this piano roll to the others in the session.

Run it from the piano roll: Tools > Scripts > FLSync skicka noter (Ctrl+Alt+Y
runs the last script again). The FLSync bridge (bridge.py) passes the notes on:
piano roll scripts can't reach the network or the FLSync MIDI script, but they
may write files. See docs/protocol_v2.md, "Notes".
"""
from flpianoroll import *
import json
import os
import time

STALE = 30.0  # the bridge refreshes context.json every few seconds while it runs


def folder():
    """<FL's user data>\\FL Studio\\Settings\\Piano roll scripts\\FLSync, as the
    bridge finds it: FL lets piano roll scripts read and write files in their
    own folder only (measured in FL 26.1.7)."""
    if os.environ.get("FLSYNC_NOTES_DIR"):  # (FLSync's tests)
        return os.environ["FLSYNC_NOTES_DIR"]
    tail = os.path.join("FL Studio", "Settings", "Piano roll scripts", "FLSync")
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Image-Line\Shared\Paths") as key:
            user = winreg.QueryValueEx(key, "Shared data")[0]
        if isinstance(user, str) and os.path.isdir(user):
            return os.path.join(user, tail)
    except BaseException:  # noqa: B036 - no registry here: FL's default place
        pass
    home = os.path.expanduser("~")
    for documents in ("Documents", os.path.join("OneDrive", "Documents"), os.path.join("OneDrive", "Dokument")):
        user = os.path.join(home, documents, "Image-Line")
        if os.path.isdir(user):
            return os.path.join(user, tail)
    return os.path.join(home, "Documents", "Image-Line", tail)


def read_context():
    """What the bridge says the piano roll shows, or None if the bridge isn't running."""
    try:
        with open(os.path.join(folder(), "context.json"), encoding="utf-8") as f:
            context = json.load(f)
    except (OSError, ValueError, SystemError):  # (SystemError: FL 26 refuses a file outside the scripts' folder)
        return None
    stamp = context.get("time") if isinstance(context, dict) else None
    if not isinstance(stamp, (int, float)) or not time.time() - stamp <= STALE:  # not: NaN is never fresh
        return None
    return context


def note_row(note):
    return [note.time, note.length, note.number, round(note.velocity, 4), round(note.pan, 4),
            round(note.release, 4), note.color, round(note.fcut, 4), round(note.fres, 4), note.pitchofs,
            int(note.slide), int(note.porta), int(note.muted), note.repeats]


def main():
    context = read_context()
    if context is None or context.get("pattern") is None or context.get("channel") is None:
        Utils.ShowMessage("FLSync: bryggan (bridge.py) är inte igång, så noterna kan inte skickas.")
        return
    out = {"pattern": context["pattern"], "channel": context["channel"], "name": context.get("name"),
           "ppq": score.PPQ, "notes": [note_row(score.getNote(i)) for i in range(score.noteCount)],
           "time": time.time()}
    path = os.path.join(folder(), "outbox.json")
    try:
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            json.dump(out, f)
        os.replace(path + ".tmp", path)  # the bridge never sees half a file
    except (OSError, SystemError):
        with open(path, "w", encoding="utf-8") as f:  # (the bridge also skips files it can't parse yet)
            json.dump(out, f)


main()
